# Only the live provider check (packages/core/test-live) reads these. The albireo CLI does not:
# it takes keys from its encrypted vault (API Keys in the panel). Albireo never reads .env files.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: OpenAI-compatible endpoint
# OPENAI_BASE_URL=
# Optional model overrides
# ALBIREO_ANTHROPIC_MODEL=claude-opus-5-5
# ALBIREO_OPENAI_MODEL=gpt-5
